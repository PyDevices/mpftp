{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mpftp",
  "mainBinaryName": "mpftp",
  "version": "0.1.2",
  "identifier": "com.pydevices.mpftp",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "PyDevices",
    "shortDescription": "File transfer, REPL and firmware for MicroPython and CircuitPython boards",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../python-win/": "python/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
