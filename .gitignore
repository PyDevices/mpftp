# Shared minimum (PyDevices package / cmod repos)
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.so
*.pyd

# Cursor IDE throwaways (do not ignore the whole .cursor/ tree)
.cursor/debug*
.cursor/plans/

# Repo-specific
node_modules/
out/
*.vsix
.DS_Store
*.log
.vscode-test/
# Legacy / local state dir if created by older builds (state is ~/.mpftp now)
.mpftp/

# Vendored Python package staged into the VSIX by `npm run prepackage`.
# The launcher beside it is committed; the package copy is not.
/extension/python/*
!/extension/python/mpftp_launch.py
